function installKipAutomationV2() {
  const props=PropertiesService.getScriptProperties();
  const bound=SpreadsheetApp.getActiveSpreadsheet();
  if(bound && !props.getProperty('SPREADSHEET_ID')) props.setProperty('SPREADSHEET_ID',bound.getId());
  props.setProperties({OPENAI_IMAGE_MODEL:DEFAULT_IMAGE_MODEL,OPENAI_IMAGE_SIZE:DEFAULT_IMAGE_SIZE,OPENAI_IMAGE_QUALITY:DEFAULT_IMAGE_QUALITY,KIP_AUTOMATION_VERSION:KIP_VERSION},false);
  if(!props.getProperty('SESSION_SECRET')) props.setProperty('SESSION_SECRET',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));
  ensureLogSheets_(); getTempFolder_(); getRegularMaterialRoot_(); LEVELS.forEach(getLevelFolder_); createKipAutomationTriggers();
  const result=health_(); console.log(JSON.stringify(result,null,2)); return result;
}

function createKipAutomationTriggers() {
  deleteKipAutomationTriggers();
  LEVELS.forEach(c => ScriptApp.newTrigger(c.handler).timeBased().atHour(c.hour).nearMinute(c.minute).everyDays(1).create());
  ScriptApp.newTrigger('cleanupExpiredTempAssets').timeBased().everyHours(1).create();
  return listKipAutomationTriggers();
}
function deleteKipAutomationTriggers() {
  const ours=LEVELS.map(x=>x.handler).concat(['cleanupExpiredTempAssets']);
  ScriptApp.getProjectTriggers().forEach(t => { if(ours.includes(t.getHandlerFunction())) ScriptApp.deleteTrigger(t); });
}
function listKipAutomationTriggers() { return ScriptApp.getProjectTriggers().map(t=>({handler:t.getHandlerFunction(),source:String(t.getEventType())})); }
function isWeekdayNow_() { const day=Utilities.formatDate(new Date(),TIME_ZONE,'EEE'); return day!=='Sat' && day!=='Sun'; }

function applyImage2MediumConfig() {
  PropertiesService.getScriptProperties().setProperties({OPENAI_IMAGE_MODEL:'gpt-image-2',OPENAI_IMAGE_SIZE:'1024x1536',OPENAI_IMAGE_QUALITY:'medium'},false);
  return showCurrentImageConfig();
}
function showCurrentImageConfig() { const p=PropertiesService.getScriptProperties(); const c={model:p.getProperty('OPENAI_IMAGE_MODEL')||DEFAULT_IMAGE_MODEL,size:p.getProperty('OPENAI_IMAGE_SIZE')||DEFAULT_IMAGE_SIZE,quality:p.getProperty('OPENAI_IMAGE_QUALITY')||DEFAULT_IMAGE_QUALITY}; console.log(JSON.stringify(c)); return c; }
function generateSessionSecret() { const s=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''); console.log('SESSION_SECRET='+s); return s; }
