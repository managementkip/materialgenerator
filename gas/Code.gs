/**
 * KIP Material Production Center — AUTOMATION V2
 * Google Apps Script backend
 *
 * LOCKED PRODUCTION POLICY
 * - Monday-Friday, Asia/Jakarta (WIB)
 * - 05:30 SD 1-3
 * - 06:00 SD 4-6
 * - 06:30 SMP/SMA/UMUM Basic
 * - 07:00 SMP/SMA/UMUM Pre-Intermediate
 * - 07:30 SMP/SMA/UMUM Intermediate
 * - One automatic attempt per page. ZERO automatic retries.
 * - Page 1 -> Page 2 -> server-side A4 PDF -> Google Drive.
 * - Human QC happens after the PDF exists.
 * - Temporary PNG versions live for 18 hours from their own creation time.
 * - Manual regeneration never deletes the previous PNG early.
 * - Regenerating one page never regenerates the other page.
 * - PDF rebuilds are free (no OpenAI request).
 *
 * Required Script Properties:
 *   OPENAI_API_KEY
 *   ADMIN_EMAIL
 *   ADMIN_PASSWORD
 *   SESSION_SECRET
 *
 * Optional Script Properties:
 *   SPREADSHEET_ID       // only for standalone Apps Script projects
 *   SESSION_HOURS        // default 12
 *
 * Created automatically by installKipAutomationV2():
 *   OPENAI_IMAGE_MODEL   = gpt-image-2
 *   OPENAI_IMAGE_SIZE    = 1024x1536
 *   OPENAI_IMAGE_QUALITY = medium
 *   KIP_TEMP_FOLDER_ID
 *   KIP_REGULAR_ROOT_FOLDER_ID
 *   KIP_LEVEL_FOLDER_<LEVELKEY>_ID
 */

const KIP_VERSION = '2.0.0';
const TIME_ZONE = 'Asia/Jakarta';
const READY_STATUS = 'READY TO GENERATE';
const DEFAULT_IMAGE_MODEL = 'gpt-image-2';
const DEFAULT_IMAGE_SIZE = '1024x1536';
const DEFAULT_IMAGE_QUALITY = 'medium';
const TEMP_FOLDER_NAME = '__KIP_TEMP_GENERATIONS__';
const TEMP_MAX_AGE_HOURS = 18;
const REGULAR_ROOT_FOLDER_NAME = 'Regular Material';
const PRODUCTION_SHEET = 'Production_Log';
const GENERATION_SHEET = 'Generation_Log';
const CLAIM_STALE_MINUTES = 20;

const A4_WIDTH_PT = 595.2756;
const A4_HEIGHT_PT = 841.8898;
const A4_WIDTH_PX = 794;
const A4_HEIGHT_PX = 1123;

const LEVELS = [
  { key:'SD13', sheetName:'SD 1-3', label:'SD 1-3', folderName:'SD 1-3', handler:'scheduledSD13', hour:5, minute:30, time:'05:30' },
  { key:'SD46', sheetName:'SD 4-6', label:'SD 4-6', folderName:'SD 4-6', handler:'scheduledSD46', hour:6, minute:0, time:'06:00' },
  { key:'BASIC', sheetName:'SMP-SMA-UMUM Basic', label:'SMP/SMA/UMUM Basic', folderName:'SMP-SMA-UMUM Basic', handler:'scheduledBasic', hour:6, minute:30, time:'06:30' },
  { key:'PREINT', sheetName:'SMP-SMA-UMUM Pre-Int', label:'SMP/SMA/UMUM Pre-Intermediate', folderName:'SMP-SMA-UMUM Pre-Intermediate', handler:'scheduledPreIntermediate', hour:7, minute:0, time:'07:00' },
  { key:'INTERMEDIATE', sheetName:'SMP-SMA-UMUM Intermediate', label:'SMP/SMA/UMUM Intermediate', folderName:'SMP-SMA-UMUM Intermediate', handler:'scheduledIntermediate', hour:7, minute:30, time:'07:30' }
];

const DB_HEADERS = ['Date','Level','Week','Meeting','Theme','Topic','Page 1 Prompt','Page 2 Prompt','Status','Material ID','Notes'];

const PRODUCTION_HEADERS = [
  'Date','Level Key','Level','Sheet Name','Material ID','Topic','Scheduled Time',
  'P1 Auto Attempted','P1 Status','P1 Version','P1 File ID','P1 File Link','P1 Generated At','P1 Expires At','P1 Claim At',
  'P2 Auto Attempted','P2 Status','P2 Version','P2 File ID','P2 File Link','P2 Generated At','P2 Expires At','P2 Claim At',
  'PDF Status','PDF Version','PDF File ID','PDF File Link','PDF Updated At','PDF Source P1 Version','PDF Source P2 Version',
  'QC Status','QC Notes','Continuity Warning','Last Error','Updated At'
];

const GENERATION_HEADERS = [
  'Timestamp','Date','Level','Material ID','Asset','Version','Mode','Status','File ID','File Link','Expires At',
  'Source P1 Version','Source P2 Version','Execution ID','Message'
];

const KIP_LOGO_JPG_BASE64 = '';
const KIP_WATERMARK_PNG_BASE64 = '';

// -----------------------------------------------------------------------------
// Web App API
// -----------------------------------------------------------------------------

function doGet() {
  return json_({ ok:true, service:'KIP Material Production Center', version:KIP_VERSION });
}

function doPost(e) {
  try {
    const body = parseBody_(e);
    const action = String(body.action || '').trim();
    if (!action) return json_({ ok:false, code:'BAD_REQUEST', error:'Missing action' });

    if (action === 'login') return json_(login_(body));
    const user = requireAuth_(body.token);

    switch (action) {
      case 'auth': return json_({ ok:true, user:{ email:user.email } });
      case 'health': return json_(health_());
      case 'materials': return json_(materialsByDate_(body.date));
      case 'asset': return json_(asset_(body));
      case 'regenerate': return json_(manualRegenerate_(body));
      case 'runLevelNow': return json_(runLevelNow_(body));
      case 'rebuildPdf': return json_(rebuildPdfAction_(body));
      case 'qc': return json_(setQc_(body));
      case 'cleanupExpired': return json_(cleanupExpiredTempAssets());
      default: return json_({ ok:false, code:'BAD_REQUEST', error:'Unknown action: ' + action });
    }
  } catch (error) {
    console.error(error && error.stack ? error.stack : error);
    return json_({
      ok:false,
      code:error && error.code ? error.code : 'SERVER_ERROR',
      error:error && error.message ? error.message : String(error)
    });
  }
}

function parseBody_(e) {
  if (!e || !e.postData || !e.postData.contents) return {};
  try { return JSON.parse(e.postData.contents); }
  catch (error) { throw appError_('BAD_REQUEST', 'Request body must be valid JSON.'); }
}
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function appError_(code, message) { const e = new Error(message); e.code = code; return e; }

// -----------------------------------------------------------------------------
// Authentication
// -----------------------------------------------------------------------------

function login_(body) {
  const props = PropertiesService.getScriptProperties();
  const adminEmail = String(props.getProperty('ADMIN_EMAIL') || '').trim().toLowerCase();
  const adminPassword = String(props.getProperty('ADMIN_PASSWORD') || '');
  const secret = String(props.getProperty('SESSION_SECRET') || '');
  if (!adminEmail || !adminPassword || !secret) throw appError_('CONFIG_MISSING', 'Set ADMIN_EMAIL, ADMIN_PASSWORD, and SESSION_SECRET in Script Properties.');

  const email = String(body.email || '').trim().toLowerCase();
  const password = String(body.password || '');
  if (email !== adminEmail || password !== adminPassword) throw appError_('LOGIN_FAILED', 'Invalid email or password.');

  const hours = Math.max(1, Math.min(72, Number(props.getProperty('SESSION_HOURS') || 12)));
  const payload = { email:adminEmail, exp:Date.now() + hours*60*60*1000 };
  return { ok:true, token:signToken_(payload, secret), user:{email:adminEmail}, expiresAt:payload.exp };
}

function requireAuth_(token) {
  if (!token) throw appError_('AUTH_REQUIRED', 'Authentication required.');
  const secret = String(PropertiesService.getScriptProperties().getProperty('SESSION_SECRET') || '');
  if (!secret) throw appError_('CONFIG_MISSING', 'SESSION_SECRET is not configured.');
  const payload = verifyToken_(String(token), secret);
  if (!payload) throw appError_('AUTH_REQUIRED', 'Invalid session. Please sign in again.');
  if (Number(payload.exp || 0) <= Date.now()) throw appError_('AUTH_EXPIRED', 'Session expired. Please sign in again.');
  return payload;
}
function signToken_(payload, secret) {
  const encoded = Utilities.base64EncodeWebSafe(JSON.stringify(payload), Utilities.Charset.UTF_8).replace(/=+$/g,'');
  const sig = Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(encoded, secret, Utilities.Charset.UTF_8)).replace(/=+$/g,'');
  return encoded + '.' + sig;
}
function verifyToken_(token, secret) {
  const parts = token.split('.');
  if (parts.length !== 2) return null;
  const expected = Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(parts[0], secret, Utilities.Charset.UTF_8)).replace(/=+$/g,'');
  if (!constantTimeEqual_(expected, parts[1])) return null;
  try { return JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString()); }
  catch (error) { return null; }
}
function constantTimeEqual_(a,b) { if (a.length !== b.length) return false; let d=0; for(let i=0;i<a.length;i++) d |= a.charCodeAt(i)^b.charCodeAt(i); return d===0; }

// -----------------------------------------------------------------------------
// Health / public state
// -----------------------------------------------------------------------------

function health_() {
  const props = PropertiesService.getScriptProperties();
  const ss = getSpreadsheet_();
  const prod = ss.getSheetByName(PRODUCTION_SHEET);
  const gen = ss.getSheetByName(GENERATION_SHEET);
  let root = null;
  try { root = getRegularMaterialRoot_(); } catch (e) {}
  return {
    ok:true,
    version:KIP_VERSION,
    configured:{
      gas:true,
      sheets:LEVELS.every(x => Boolean(ss.getSheetByName(x.sheetName))),
      logs:Boolean(prod && gen),
      openai:Boolean(props.getProperty('OPENAI_API_KEY')),
      auth:Boolean(props.getProperty('ADMIN_EMAIL') && props.getProperty('ADMIN_PASSWORD') && props.getProperty('SESSION_SECRET')),
      drive:Boolean(root)
    },
    image:{ model:props.getProperty('OPENAI_IMAGE_MODEL') || DEFAULT_IMAGE_MODEL, size:props.getProperty('OPENAI_IMAGE_SIZE') || DEFAULT_IMAGE_SIZE, quality:props.getProperty('OPENAI_IMAGE_QUALITY') || DEFAULT_IMAGE_QUALITY },
    retentionHours:TEMP_MAX_AGE_HOURS,
    timeZone:TIME_ZONE,
    schedule:LEVELS.map(x => ({ key:x.key, label:x.label, time:x.time })),
    links:{
      spreadsheet:ss.getUrl(),
      productionLog:prod ? ss.getUrl() + '#gid=' + prod.getSheetId() : '',
      generationLog:gen ? ss.getUrl() + '#gid=' + gen.getSheetId() : '',
      regularMaterial:root ? root.getUrl() : ''
    }
  };
}

// -----------------------------------------------------------------------------
// Curriculum database — read only
// -----------------------------------------------------------------------------

function getSpreadsheet_() {
  const props = PropertiesService.getScriptProperties();
  const explicit = String(props.getProperty('SPREADSHEET_ID') || '').trim();
  if (explicit) return SpreadsheetApp.openById(explicit);
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (!active) throw appError_('SHEET_NOT_FOUND', 'Bind this Apps Script project to the curriculum spreadsheet or set SPREADSHEET_ID.');
  return active;
}

function materialsByDate_(dateString) {
  const date = validateDate_(dateString);
  ensureLogSheets_();
  const ss = getSpreadsheet_();
  const materials = LEVELS.map(config => {
    const sheet = ss.getSheetByName(config.sheetName);
    if (!sheet) return { key:config.key, label:config.label, sheetName:config.sheetName, scheduleTime:config.time, ready:false, material:null, error:'Sheet missing' };
    const rows = sheetObjects_(sheet);
    const row = rows.find(r => normalizeDate_(r.Date) === date);
    if (!row) return { key:config.key, label:config.label, sheetName:config.sheetName, scheduleTime:config.time, ready:false, material:null, error:'No material for this date' };
    const material = publicMaterial_(row, config);
    const production = getProductionPublicByKey_(date, config.key, material.materialId);
    return { key:config.key, label:config.label, sheetName:config.sheetName, scheduleTime:config.time, ready:String(row.Status || '').trim().toUpperCase() === READY_STATUS, material:material, production:production };
  });
  return { ok:true, date:date, count:materials.filter(x => x.material).length, materials:materials };
}

function sheetObjects_(sheet) {
  const values = sheet.getDataRange().getValues();
  if (!values.length) return [];
  const headers = values[0].map(x => String(x).trim());
  validateHeaders_(headers, sheet.getName());
  return values.slice(1).filter(row => row.some(v => String(v).trim() !== '')).map(row => {
    const obj={}; headers.forEach((h,i) => obj[h]=row[i]); return obj;
  });
}
function validateHeaders_(headers, sheetName) {
  const missing = DB_HEADERS.filter(h => !headers.includes(h));
  if (missing.length) throw appError_('BAD_HEADERS', sheetName + ' is missing: ' + missing.join(', '));
}
function normalizeDate_(value) {
  if (value instanceof Date && !isNaN(value)) return Utilities.formatDate(value, TIME_ZONE, 'yyyy-MM-dd');
  const s=String(value || '').trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const d=new Date(s); return isNaN(d) ? s : Utilities.formatDate(d, TIME_ZONE, 'yyyy-MM-dd');
}
function validateDate_(value) { const s=String(value || '').trim(); if(!/^\d{4}-\d{2}-\d{2}$/.test(s)) throw appError_('BAD_REQUEST','Date must use YYYY-MM-DD.'); return s; }
function publicMaterial_(row, config) {
  return { date:normalizeDate_(row.Date), level:String(row.Level || config.label), week:String(row.Week || ''), meeting:String(row.Meeting || ''), theme:String(row.Theme || ''), topic:String(row.Topic || ''), status:String(row.Status || ''), materialId:String(row['Material ID'] || ''), notes:String(row.Notes || ''), levelKey:config.key };
}
function findMaterialById_(materialId) {
  const id=String(materialId || '').trim(); if(!id) throw appError_('BAD_REQUEST','Material ID is required.');
  const ss=getSpreadsheet_();
  for (const config of LEVELS) {
    const sheet=ss.getSheetByName(config.sheetName); if(!sheet) continue;
    const rows=sheetObjects_(sheet);
    const row=rows.find(r => String(r['Material ID'] || '').trim() === id);
    if(row) return { row:row, config:config, material:publicMaterial_(row,config) };
  }
  throw appError_('MATERIAL_NOT_FOUND','Material ID was not found in the five curriculum sheets.');
}
function findMaterialForDateLevel_(date, config) {
  const sheet=getSpreadsheet_().getSheetByName(config.sheetName);
  if(!sheet) throw appError_('SHEET_NOT_FOUND','Missing sheet: ' + config.sheetName);
  const row=sheetObjects_(sheet).find(r => normalizeDate_(r.Date) === date);
  if(!row) throw appError_('MATERIAL_NOT_FOUND','No ' + config.label + ' material found for ' + date + '.');
  if(String(row.Status || '').trim().toUpperCase() !== READY_STATUS) throw appError_('NOT_READY','Material status must be ' + READY_STATUS + '.');
  return { row:row, config:config, material:publicMaterial_(row,config) };
}
function levelByKey_(key) { const v=LEVELS.find(x => x.key === String(key || '').toUpperCase()); if(!v) throw appError_('BAD_REQUEST','Unknown level key.'); return v; }

// -----------------------------------------------------------------------------
// Log sheets / idempotency state
// -----------------------------------------------------------------------------

function ensureLogSheets_() {
  const ss=getSpreadsheet_();
  ensureSheet_(ss, PRODUCTION_SHEET, PRODUCTION_HEADERS);
  ensureSheet_(ss, GENERATION_SHEET, GENERATION_HEADERS);
}
function ensureSheet_(ss, name, headers) {
  let sheet=ss.getSheetByName(name);
  const created=!sheet;
  if(!sheet) sheet=ss.insertSheet(name);
  if(sheet.getMaxColumns() < headers.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length-sheet.getMaxColumns());
  const current=sheet.getRange(1,1,1,headers.length).getValues()[0].map(String);
  const mismatch=headers.some((h,i) => current[i] !== h);
  if(mismatch) {
    if(sheet.getLastRow() > 1) throw appError_('LOG_SCHEMA_MISMATCH', name + ' exists but its headers do not match Automation V2. Rename the old log sheet, then run installKipAutomationV2() again.');
    sheet.clear();
    sheet.getRange(1,1,1,headers.length).setValues([headers]);
  }
  if(created || mismatch) styleLogSheet_(sheet, headers.length);
  return sheet;
}
function styleLogSheet_(sheet, cols) {
  sheet.setFrozenRows(1);
  sheet.getRange(1,1,1,cols).setFontWeight('bold').setBackground('#082d73').setFontColor('#ffffff').setVerticalAlignment('middle');
  sheet.autoResizeColumns(1, Math.min(cols, 12));
}
function prodHeaderMap_(sheet) { const h=sheet.getRange(1,1,1,PRODUCTION_HEADERS.length).getValues()[0]; const m={}; h.forEach((x,i)=>m[String(x)]=i+1); return m; }
function getProductionRecord_(date, levelKey, materialId, create, materialInfo) {
  const sheet=ensureSheet_(getSpreadsheet_(), PRODUCTION_SHEET, PRODUCTION_HEADERS);
  const values=sheet.getDataRange().getValues();
  const headers=values[0].map(String);
  for(let r=1;r<values.length;r++) {
    const obj={}; headers.forEach((h,i)=>obj[h]=values[r][i]);
    if(String(obj.Date)===date && String(obj['Level Key'])===levelKey && String(obj['Material ID'])===materialId) return { sheet:sheet,row:r+1,obj:obj };
  }
  if(!create) return null;
  const now=isoNow_();
  const base={ 'Date':date,'Level Key':levelKey,'Level':materialInfo.material.level,'Sheet Name':materialInfo.config.sheetName,'Material ID':materialId,'Topic':materialInfo.material.topic,'Scheduled Time':materialInfo.config.time,'P1 Auto Attempted':false,'P1 Status':'NOT_STARTED','P1 Version':0,'P2 Auto Attempted':false,'P2 Status':'NOT_STARTED','P2 Version':0,'PDF Status':'NOT_STARTED','PDF Version':0,'QC Status':'PENDING','Continuity Warning':'','Last Error':'','Updated At':now };
  const row=PRODUCTION_HEADERS.map(h => Object.prototype.hasOwnProperty.call(base,h) ? base[h] : '');
  sheet.appendRow(row);
  return { sheet:sheet,row:sheet.getLastRow(),obj:base };
}
function setProdFields_(record, fields) {
  const map=prodHeaderMap_(record.sheet);
  Object.keys(fields).forEach(k => { if(map[k]) record.sheet.getRange(record.row,map[k]).setValue(fields[k]); });
  if(map['Updated At']) record.sheet.getRange(record.row,map['Updated At']).setValue(isoNow_());
}
function setProdLinkFormula_(record, header, url, label) {
  const map=prodHeaderMap_(record.sheet); if(!map[header]) return;
  if(!url) { record.sheet.getRange(record.row,map[header]).clearContent(); return; }
  record.sheet.getRange(record.row,map[header]).setFormula('=HYPERLINK("' + String(url).replace(/"/g,'""') + '","' + String(label).replace(/"/g,'""') + '")');
}
function refreshProd_(record) {
  const values=record.sheet.getRange(record.row,1,1,PRODUCTION_HEADERS.length).getValues()[0];
  const obj={}; PRODUCTION_HEADERS.forEach((h,i)=>obj[h]=values[i]); record.obj=obj; return record;
}
function getProductionPublicByKey_(date,key,materialId) {
  const rec=getProductionRecord_(date,key,materialId,false,null); return rec ? publicProduction_(refreshProd_(rec).obj) : emptyProduction_();
}
function emptyProduction_() { return { p1:{status:'NOT_STARTED',version:0},p2:{status:'NOT_STARTED',version:0},pdf:{status:'NOT_STARTED',version:0},qcStatus:'PENDING',qcNotes:'',continuityWarning:'',lastError:'' }; }
function publicProduction_(o) {
  const now=Date.now();
  function asset(prefix) {
    const exp=String(o[prefix+' Expires At'] || '');
    const expired=exp ? (new Date(exp).getTime() <= now) : false;
    const id=String(o[prefix+' File ID'] || '');
    return { status:String(o[prefix+' Status'] || 'NOT_STARTED'),version:Number(o[prefix+' Version'] || 0),fileId:id,driveUrl:id ? driveFileUrl_(id) : '',generatedAt:String(o[prefix+' Generated At'] || ''),expiresAt:exp,expired:expired,autoAttempted:toBool_(o[prefix+' Auto Attempted']) };
  }
  const pdfId=String(o['PDF File ID'] || '');
  return { p1:asset('P1'),p2:asset('P2'),pdf:{status:String(o['PDF Status'] || 'NOT_STARTED'),version:Number(o['PDF Version'] || 0),fileId:pdfId,driveUrl:pdfId ? driveFileUrl_(pdfId) : '',updatedAt:String(o['PDF Updated At'] || ''),sourceP1Version:Number(o['PDF Source P1 Version']||0),sourceP2Version:Number(o['PDF Source P2 Version']||0)},qcStatus:String(o['QC Status'] || 'PENDING'),qcNotes:String(o['QC Notes'] || ''),continuityWarning:String(o['Continuity Warning'] || ''),lastError:String(o['Last Error'] || '') };
}
function toBool_(v) { return v === true || String(v).toLowerCase() === 'true' || String(v) === '1'; }
function isoNow_() { return new Date().toISOString(); }
function addHoursIso_(date,hours) { return new Date(date.getTime()+hours*60*60*1000).toISOString(); }

function appendGenerationEvent_(data) {
  const sheet=ensureSheet_(getSpreadsheet_(), GENERATION_SHEET, GENERATION_HEADERS);
  const row=GENERATION_HEADERS.map(h => Object.prototype.hasOwnProperty.call(data,h) ? data[h] : '');
  sheet.appendRow(row);
  if(data['File Link']) {
    const col=GENERATION_HEADERS.indexOf('File Link')+1;
    sheet.getRange(sheet.getLastRow(),col).setFormula('=HYPERLINK("' + String(data['File Link']).replace(/"/g,'""') + '","Open file")');
  }
}

// -----------------------------------------------------------------------------
// Automatic trigger handlers — one level per scheduled trigger
// -----------------------------------------------------------------------------

function scheduledSD13() { return runScheduledLevel_('SD13'); }
function scheduledSD46() { return runScheduledLevel_('SD46'); }
function scheduledBasic() { return runScheduledLevel_('BASIC'); }
function scheduledPreIntermediate() { return runScheduledLevel_('PREINT'); }
function scheduledIntermediate() { return runScheduledLevel_('INTERMEDIATE'); }

function runScheduledLevel_(levelKey) {
  if(!isWeekdayNow_()) return { ok:true, skipped:true, reason:'WEEKEND' };
  const config=levelByKey_(levelKey);
  const date=Utilities.formatDate(new Date(), TIME_ZONE, 'yyyy-MM-dd');
  return runPipelineForDateLevel_(date, config, 'AUTO');
}

function runLevelNow_(body) {
  const date=validateDate_(body.date);
  const config=levelByKey_(body.levelKey);
  return runPipelineForDateLevel_(date, config, 'RUN_NOW');
}

function runPipelineForDateLevel_(date, config, mode) {
  ensureLogSheets_();
  const info=findMaterialForDateLevel_(date, config);
  let record=withShortLock_(function(){ return getProductionRecord_(date,config.key,info.material.materialId,true,info); });

  const p1=attemptAutomaticPageOnce_(record,info,1,mode);
  record=refreshProd_(record);
  if(!pageUsable_(record.obj,'P1')) return responseForRecord_(record, 'Pipeline stopped after Page 1. No automatic retry.');

  const p2=attemptAutomaticPageOnce_(record,info,2,mode);
  record=refreshProd_(record);
  if(!pageUsable_(record.obj,'P2')) return responseForRecord_(record, 'Pipeline stopped after Page 2. No automatic retry.');

  try { buildPdfIfNeeded_(record, info, mode); }
  catch(error) { setProdFields_(record, {'PDF Status':'ERROR','Last Error':'PDF: '+error.message}); appendGenerationEvent_({'Timestamp':isoNow_(),'Date':date,'Level':info.material.level,'Material ID':info.material.materialId,'Asset':'PDF','Version':Number(refreshProd_(record).obj['PDF Version']||0)+1,'Mode':mode,'Status':'ERROR','Execution ID':Utilities.getUuid(),'Message':error.message}); }
  return responseForRecord_(refreshProd_(record), 'Pipeline finished.');
}

function attemptAutomaticPageOnce_(record, info, page, mode) {
  const p='P'+page;
  const claim=withShortLock_(function(){
    refreshProd_(record);
    const o=record.obj;
    if(toBool_(o[p+' Auto Attempted'])) return {run:false,reason:'ALREADY_AUTO_ATTEMPTED'};
    if(pageUsable_(o,p)) {
      setProdFields_(record,{[p+' Auto Attempted']:true});
      return {run:false,reason:'EXISTING_SUCCESS'};
    }
    if(isFreshClaim_(o[p+' Status'],o[p+' Claim At'])) return {run:false,reason:'BUSY'};
    setProdFields_(record,{[p+' Auto Attempted']:true,[p+' Status']:'AUTO_RUNNING',[p+' Claim At']:isoNow_(),'Last Error':''});
    return {run:true,executionId:Utilities.getUuid()};
  });
  if(!claim.run) return claim;

  try {
    const sourceP1 = page===2 ? requireCurrentTempFile_(record,'P1') : null;
    const generated=generateImage_(info,page,sourceP1 ? sourceP1.file : null);
    finalizeImageSuccess_(record,info,page,generated,mode,claim.executionId);
    return {run:true,ok:true};
  } catch(error) {
    finalizeImageError_(record,info,page,error,mode,claim.executionId);
    return {run:true,ok:false,error:error.message};
  }
}

// -----------------------------------------------------------------------------
// Explicit human actions — paid regeneration only after confirmation in UI
// -----------------------------------------------------------------------------

function manualRegenerate_(body) {
  const page=Number(body.page); if(page!==1 && page!==2) throw appError_('BAD_REQUEST','Page must be 1 or 2.');
  const info=findMaterialById_(body.materialId);
  if(String(info.row.Status || '').trim().toUpperCase() !== READY_STATUS) throw appError_('NOT_READY','Material status must be ' + READY_STATUS + '.');
  const date=normalizeDate_(info.row.Date);
  let record=withShortLock_(function(){ return getProductionRecord_(date,info.config.key,info.material.materialId,true,info); });
  const p='P'+page;
  const executionId=Utilities.getUuid();

  withShortLock_(function(){
    refreshProd_(record);
    if(isFreshClaim_(record.obj[p+' Status'],record.obj[p+' Claim At'])) throw appError_('BUSY', 'Page ' + page + ' is already generating.');
    setProdFields_(record,{[p+' Status']:'MANUAL_RUNNING',[p+' Claim At']:isoNow_(),'Last Error':''});
  });

  try {
    const sourceP1=page===2 ? requireCurrentTempFile_(record,'P1') : null;
    const generated=generateImage_(info,page,sourceP1 ? sourceP1.file : null);
    finalizeImageSuccess_(record,info,page,generated,'MANUAL',executionId);
    refreshProd_(record);
    if(page===1 && Number(record.obj['P2 Version']||0)>0) setProdFields_(record,{'Continuity Warning':'Page 1 was regenerated after Page 2. Check continuity; Page 2 was NOT regenerated.'});
    if(page===2) setProdFields_(record,{'Continuity Warning':''});

    // Free rebuild only. Never regenerate the other image.
    refreshProd_(record);
    if(pageUsable_(record.obj,'P1') && pageUsable_(record.obj,'P2')) {
      try { buildPdfIfNeeded_(record,info,'MANUAL_REBUILD',true); }
      catch(pdfError) { setProdFields_(record,{'PDF Status':'ERROR','Last Error':'PDF rebuild: '+pdfError.message}); }
    }
    return responseForRecord_(refreshProd_(record),'Page '+page+' regenerated once. Previous PNG versions remain until their own 18-hour expiry.');
  } catch(error) {
    finalizeImageError_(record,info,page,error,'MANUAL',executionId);
    throw error;
  }
}

function rebuildPdfAction_(body) {
  const info=findMaterialById_(body.materialId);
  const date=normalizeDate_(info.row.Date);
  const record=getProductionRecord_(date,info.config.key,info.material.materialId,false,null);
  if(!record) throw appError_('NOT_GENERATED','No production record exists yet.');
  requireCurrentTempFile_(record,'P1'); requireCurrentTempFile_(record,'P2');
  buildPdfIfNeeded_(record,info,'MANUAL_PDF',true);
  return responseForRecord_(refreshProd_(record),'PDF rebuilt without an OpenAI call.');
}

function setQc_(body) {
  const info=findMaterialById_(body.materialId);
  const date=normalizeDate_(info.row.Date);
  const record=getProductionRecord_(date,info.config.key,info.material.materialId,false,null);
  if(!record) throw appError_('NOT_GENERATED','No production record exists.');
  const status=String(body.status || 'APPROVED').toUpperCase();
  if(!['APPROVED','PENDING'].includes(status)) throw appError_('BAD_REQUEST','QC status must be APPROVED or PENDING.');
  setProdFields_(record,{'QC Status':status,'QC Notes':String(body.notes || '')});
  return responseForRecord_(refreshProd_(record),'QC status updated.');
}

function responseForRecord_(record,message) { return { ok:true,message:message,production:publicProduction_(record.obj) }; }

// -----------------------------------------------------------------------------
// Claiming / duplicate protection
// -----------------------------------------------------------------------------

function withShortLock_(fn) {
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(30000)) throw appError_('LOCK_TIMEOUT','Could not acquire the short state lock. No OpenAI request was started.');
  try { return fn(); } finally { lock.releaseLock(); }
}
function isFreshClaim_(status,claimAt) {
  if(!String(status || '').endsWith('_RUNNING')) return false;
  const t=new Date(String(claimAt || '')).getTime();
  return t && Date.now()-t < CLAIM_STALE_MINUTES*60*1000;
}
function pageUsable_(o,prefix) {
  const id=String(o[prefix+' File ID'] || ''); const ver=Number(o[prefix+' Version']||0); const status=String(o[prefix+' Status']||'');
  return Boolean(id && ver>0 && status==='DONE');
}

// -----------------------------------------------------------------------------
// OpenAI image generation/editing — exact Sheet prompt, no AI QC, no auto retry
// -----------------------------------------------------------------------------

function generateImage_(info,page,page1File) {
  const prompt=page===1 ? String(info.row['Page 1 Prompt'] || '') : String(info.row['Page 2 Prompt'] || '');
  if(!prompt) throw appError_('PROMPT_MISSING','Page '+page+' Prompt is empty.');
  const refs=[];
  if(page===2) refs.push({filename:'page-1-current.png',blob:page1File.getBlob()});
  refs.push({filename:'kip-logo.jpg',blob:kipLogoBlob_()});
  const result=callOpenAiImageEdit_(prompt,refs);
  const bytes=Utilities.base64Decode(result.b64);
  return { bytes:bytes,promptHash:sha256Hex_(prompt).slice(0,16),model:result.model,size:result.size,quality:result.quality };
}

function callOpenAiImageEdit_(prompt,referenceFiles) {
  const props=PropertiesService.getScriptProperties();
  const apiKey=String(props.getProperty('OPENAI_API_KEY') || '').trim();
  if(!apiKey) throw appError_('CONFIG_MISSING','OPENAI_API_KEY is missing.');
  const model=props.getProperty('OPENAI_IMAGE_MODEL') || DEFAULT_IMAGE_MODEL;
  const size=props.getProperty('OPENAI_IMAGE_SIZE') || DEFAULT_IMAGE_SIZE;
  const quality=props.getProperty('OPENAI_IMAGE_QUALITY') || DEFAULT_IMAGE_QUALITY;
  const boundary='----KIPBoundary'+Utilities.getUuid().replace(/-/g,'');
  const fields=[['model',model],['prompt',prompt],['size',size],['quality',quality],['output_format','png']];
  const files=referenceFiles.map(x=>({fieldName:'image[]',filename:x.filename,mimeType:x.blob.getContentType()||'application/octet-stream',bytes:x.blob.getBytes()}));
  const payload=buildMultipart_(boundary,fields,files);
  const response=UrlFetchApp.fetch('https://api.openai.com/v1/images/edits',{method:'post',headers:{Authorization:'Bearer '+apiKey},contentType:'multipart/form-data; boundary='+boundary,payload:payload,muteHttpExceptions:true,followRedirects:true});
  const status=response.getResponseCode(); const text=response.getContentText(); let data={};
  try { data=JSON.parse(text); } catch(e) {}
  if(status<200 || status>=300) {
    const msg=data && data.error && data.error.message ? data.error.message : 'OpenAI request failed with HTTP '+status;
    throw appError_('OPENAI_ERROR',msg);
  }
  const b64=data && data.data && data.data[0] && data.data[0].b64_json;
  if(!b64) throw appError_('OPENAI_EMPTY','OpenAI returned no image data.');
  return {b64:b64,model:model,size:size,quality:quality};
}
function buildMultipart_(boundary,fields,files) { const b=[]; fields.forEach(p=>{appendStringBytes_(b,'--'+boundary+'\r\n');appendStringBytes_(b,'Content-Disposition: form-data; name="'+p[0]+'"\r\n\r\n');appendStringBytes_(b,String(p[1])+'\r\n');}); files.forEach(f=>{appendStringBytes_(b,'--'+boundary+'\r\n');appendStringBytes_(b,'Content-Disposition: form-data; name="'+f.fieldName+'"; filename="'+f.filename.replace(/"/g,'')+'"\r\n');appendStringBytes_(b,'Content-Type: '+f.mimeType+'\r\n\r\n');appendBytes_(b,f.bytes);appendStringBytes_(b,'\r\n');}); appendStringBytes_(b,'--'+boundary+'--\r\n'); return b; }
function appendStringBytes_(target,text) { appendBytes_(target,Utilities.newBlob(text,'text/plain').getBytes()); }
function appendBytes_(target,source) { for(let i=0;i<source.length;i++) target.push(source[i]); }
function kipLogoBlob_() { return Utilities.newBlob(Utilities.base64Decode(KIP_LOGO_JPG_BASE64),'image/jpeg','kip-logo.jpg'); }
function kipWatermarkBlob_() { return Utilities.newBlob(Utilities.base64Decode(KIP_WATERMARK_PNG_BASE64),'image/png','kip-watermark.png'); }
function sha256Hex_(text) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(b=>('0'+((b<0?b+256:b).toString(16))).slice(-2)).join(''); }

function finalizeImageSuccess_(record,info,page,generated,mode,executionId) {
  const now=new Date(); const expiresAt=addHoursIso_(now,TEMP_MAX_AGE_HOURS); const p='P'+page;
  withShortLock_(function(){
    refreshProd_(record);
    const version=Number(record.obj[p+' Version']||0)+1;
    const file=saveTempImage_(generated.bytes,info.material.materialId,page,version,expiresAt);
    setProdFields_(record,{[p+' Status']:'DONE',[p+' Version']:version,[p+' File ID']:file.getId(),[p+' Generated At']:now.toISOString(),[p+' Expires At']:expiresAt,[p+' Claim At']:'','Last Error':''});
    setProdLinkFormula_(record,p+' File Link',file.getUrl(),'Open '+p+' v'+version);
    appendGenerationEvent_({'Timestamp':now.toISOString(),'Date':info.material.date,'Level':info.material.level,'Material ID':info.material.materialId,'Asset':p,'Version':version,'Mode':mode,'Status':'CREATED','File ID':file.getId(),'File Link':file.getUrl(),'Expires At':expiresAt,'Source P1 Version':page===2?Number(record.obj['P1 Version']||0):'','Execution ID':executionId,'Message':generated.model+' / '+generated.size+' / '+generated.quality+' / prompt '+generated.promptHash});
  });
}
function finalizeImageError_(record,info,page,error,mode,executionId) {
  const p='P'+page;
  withShortLock_(function(){ setProdFields_(record,{[p+' Status']:'ERROR',[p+' Claim At']:'','Last Error':p+': '+error.message}); appendGenerationEvent_({'Timestamp':isoNow_(),'Date':info.material.date,'Level':info.material.level,'Material ID':info.material.materialId,'Asset':p,'Version':Number(refreshProd_(record).obj[p+' Version']||0)+1,'Mode':mode,'Status':'ERROR','Execution ID':executionId,'Message':error.message}); });
}

// -----------------------------------------------------------------------------
// Temporary images — 18-hour version retention
// -----------------------------------------------------------------------------

function getTempFolder_() {
  const props=PropertiesService.getScriptProperties(); const id=String(props.getProperty('KIP_TEMP_FOLDER_ID')||'').trim();
  if(id) { try { return DriveApp.getFolderById(id); } catch(e) { props.deleteProperty('KIP_TEMP_FOLDER_ID'); } }
  const folder=DriveApp.createFolder(TEMP_FOLDER_NAME); props.setProperty('KIP_TEMP_FOLDER_ID',folder.getId()); return folder;
}
function saveTempImage_(bytes,materialId,page,version,expiresAt) {
  const safe=String(materialId||'material').replace(/[^A-Za-z0-9._-]+/g,'-');
  const file=getTempFolder_().createFile(Utilities.newBlob(bytes,'image/png',safe+'__P'+page+'__v'+version+'__'+Date.now()+'.png'));
  file.setDescription('KIP_TEMP|expires='+expiresAt+'|material='+safe+'|page='+page+'|version='+version); return file;
}
function requireCurrentTempFile_(record,prefix) {
  refreshProd_(record); const id=String(record.obj[prefix+' File ID']||''); const exp=String(record.obj[prefix+' Expires At']||'');
  if(!id) throw appError_(prefix+'_MISSING',prefix+' source image does not exist.');
  if(exp && new Date(exp).getTime() <= Date.now()) throw appError_(prefix+'_EXPIRED',prefix+' source image has passed its 18-hour retention window. Regenerate it manually if needed.');
  let file; try { file=DriveApp.getFileById(id); } catch(e) { throw appError_(prefix+'_MISSING',prefix+' source image is unavailable.'); }
  if(file.isTrashed && file.isTrashed()) throw appError_(prefix+'_EXPIRED',prefix+' source image has been disposed.');
  if(!isFileInTempFolder_(file)) throw appError_('TEMP_FILE_INVALID','Source image is not in the KIP temp folder.');
  return {file:file,version:Number(record.obj[prefix+' Version']||0)};
}
function isFileInTempFolder_(file) { const id=getTempFolder_().getId(); const p=file.getParents(); while(p.hasNext()) if(p.next().getId()===id) return true; return false; }

function asset_(body) {
  const id=String(body.fileId||'').trim(); if(!id) throw appError_('BAD_REQUEST','fileId is required.');
  let file; try { file=DriveApp.getFileById(id); } catch(e) { throw appError_('ASSET_MISSING','Temporary image not found.'); }
  if(!isFileInTempFolder_(file)) throw appError_('ASSET_INVALID','File is not a KIP temporary image.');
  if(file.isTrashed && file.isTrashed()) throw appError_('ASSET_EXPIRED','Temporary image has been disposed.');
  const blob=file.getBlob(); return {ok:true,fileId:id,mimeType:blob.getContentType()||'image/png',b64:Utilities.base64Encode(blob.getBytes())};
}

function cleanupExpiredTempAssets() {
  ensureLogSheets_(); const sheet=getSpreadsheet_().getSheetByName(GENERATION_SHEET); const values=sheet.getDataRange().getValues();
  const headers=values[0].map(String); const idx={}; headers.forEach((h,i)=>idx[h]=i); let cleaned=0;
  for(let r=1;r<values.length;r++) {
    const asset=String(values[r][idx['Asset']]||''); const status=String(values[r][idx['Status']]||''); const exp=String(values[r][idx['Expires At']]||''); const id=String(values[r][idx['File ID']]||'');
    if(!['P1','P2'].includes(asset) || !id || !exp || status==='EXPIRED') continue;
    if(new Date(exp).getTime() > Date.now()) continue;
    try { const f=DriveApp.getFileById(id); if(isFileInTempFolder_(f) && !(f.isTrashed && f.isTrashed())) f.setTrashed(true); } catch(e) {}
    sheet.getRange(r+1,idx['Status']+1).setValue('EXPIRED'); cleaned++;
  }
  // Fallback cleanup for orphan temp files/documents after 18h.
  const cutoff=Date.now()-TEMP_MAX_AGE_HOURS*60*60*1000; const files=getTempFolder_().getFiles();
  while(files.hasNext()) { const f=files.next(); try { if(f.getDateCreated().getTime()<cutoff) f.setTrashed(true); } catch(e){} }
  return {ok:true,cleaned:cleaned,retentionHours:TEMP_MAX_AGE_HOURS};
}

// -----------------------------------------------------------------------------
// Server-side A4 PDF + deterministic KIP watermark + Google Drive storage
// -----------------------------------------------------------------------------

function buildPdfIfNeeded_(record,info,mode,force) {
  refreshProd_(record);
  const p1=requireCurrentTempFile_(record,'P1'); const p2=requireCurrentTempFile_(record,'P2');
  const o=record.obj;
  const same=String(o['PDF Status'])==='READY' && Number(o['PDF Source P1 Version']||0)===p1.version && Number(o['PDF Source P2 Version']||0)===p2.version && String(o['PDF File ID']||'');
  if(same && !force) return {skipped:true};

  setProdFields_(record,{'PDF Status':'BUILDING','Last Error':''});
  const version=Number(refreshProd_(record).obj['PDF Version']||0)+1;
  const filename=sanitizeFilename_(info.material.materialId)+'__'+sanitizeFilename_(info.material.topic)+'__v'+version+'.pdf';
  const pdfBlob=createA4PdfBlob_(p1.file.getBlob(),p2.file.getBlob(),filename);
  const folder=getLevelFolder_(info.config); const file=folder.createFile(pdfBlob);
  const now=isoNow_();
  setProdFields_(record,{'PDF Status':'READY','PDF Version':version,'PDF File ID':file.getId(),'PDF Updated At':now,'PDF Source P1 Version':p1.version,'PDF Source P2 Version':p2.version,'QC Status':'PENDING','Last Error':''});
  setProdLinkFormula_(record,'PDF File Link',file.getUrl(),'Open PDF v'+version);
  appendGenerationEvent_({'Timestamp':now,'Date':info.material.date,'Level':info.material.level,'Material ID':info.material.materialId,'Asset':'PDF','Version':version,'Mode':mode,'Status':'CREATED','File ID':file.getId(),'File Link':file.getUrl(),'Source P1 Version':p1.version,'Source P2 Version':p2.version,'Execution ID':Utilities.getUuid(),'Message':'2-page A4 PDF stored in '+REGULAR_ROOT_FOLDER_NAME+'/'+info.config.folderName});
  return {skipped:false,file:file};
}

function createA4PdfBlob_(page1Blob,page2Blob,filename) {
  const doc=DocumentApp.create('__KIP_PDF_BUILD__'+Utilities.getUuid());
  const docFile=DriveApp.getFileById(doc.getId());
  try { docFile.moveTo(getTempFolder_()); } catch(e) {}
  const body=getDocBody_(doc);
  body.setPageWidth(A4_WIDTH_PT).setPageHeight(A4_HEIGHT_PT).setMarginTop(0).setMarginBottom(0).setMarginLeft(0).setMarginRight(0);
  clearBody_(body);
  addFullPage_(body,page1Blob,false);
  addFullPage_(body,page2Blob,true);
  doc.saveAndClose();
  Utilities.sleep(1200);
  const pdf=DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF).setName(filename);
  try { DriveApp.getFileById(doc.getId()).setTrashed(true); } catch(e) {}
  return pdf;
}
function getDocBody_(doc) { try { return doc.getActiveTab().asDocumentTab().getBody(); } catch(e) { return doc.getBody(); } }
function clearBody_(body) { body.clear(); }
function addFullPage_(body,imageBlob,newPage) {
  if(newPage) body.appendPageBreak();
  const p=body.appendParagraph(' '); p.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1);
  p.addPositionedImage(imageBlob).setLayout(DocumentApp.PositionedLayout.ABOVE_TEXT).setLeftOffset(0).setTopOffset(0).setWidth(A4_WIDTH_PX).setHeight(A4_HEIGHT_PX);
  const wm=kipWatermarkBlob_();
  const wmWidth=128; const wmHeight=Math.round(128 * 554 / 788);
  p.addPositionedImage(wm).setLayout(DocumentApp.PositionedLayout.ABOVE_TEXT).setLeftOffset(A4_WIDTH_PT-108).setTopOffset(A4_HEIGHT_PT-82).setWidth(wmWidth).setHeight(wmHeight);
}

// -----------------------------------------------------------------------------
// Google Drive folder structure
// -----------------------------------------------------------------------------

function getRegularMaterialRoot_() {
  const props=PropertiesService.getScriptProperties(); const id=String(props.getProperty('KIP_REGULAR_ROOT_FOLDER_ID')||'').trim();
  if(id) { try { return DriveApp.getFolderById(id); } catch(e) { props.deleteProperty('KIP_REGULAR_ROOT_FOLDER_ID'); } }
  const driveRoot=DriveApp.getRootFolder(); const matches=driveRoot.getFoldersByName(REGULAR_ROOT_FOLDER_NAME); const folder=matches.hasNext()?matches.next():driveRoot.createFolder(REGULAR_ROOT_FOLDER_NAME);
  props.setProperty('KIP_REGULAR_ROOT_FOLDER_ID',folder.getId()); return folder;
}
function getLevelFolder_(config) {
  const props=PropertiesService.getScriptProperties(); const prop='KIP_LEVEL_FOLDER_'+config.key+'_ID'; const id=String(props.getProperty(prop)||'').trim();
  if(id) { try { return DriveApp.getFolderById(id); } catch(e) { props.deleteProperty(prop); } }
  const root=getRegularMaterialRoot_(); const it=root.getFoldersByName(config.folderName); const folder=it.hasNext()?it.next():root.createFolder(config.folderName);
  props.setProperty(prop,folder.getId()); return folder;
}
function driveFileUrl_(id) { return id ? 'https://drive.google.com/file/d/'+id+'/view' : ''; }
function sanitizeFilename_(text) { return String(text||'material').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[\\/:*?"<>|]/g,'').replace(/[^A-Za-z0-9._ -]+/g,'').trim().replace(/\s+/g,'-').replace(/-+/g,'-').slice(0,120)||'material'; }

